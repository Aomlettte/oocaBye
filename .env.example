# Secret that lets YOU reply as the letter writer.
# Open the site once with  https://your-site.vercel.app/?me=<AUTHOR_KEY>
AUTHOR_KEY=change-me-to-something-long

# Added automatically when you connect Upstash Redis from the Vercel Marketplace.
# Without these the app uses in-memory storage (fine for local dev only).
KV_REST_API_URL=
KV_REST_API_TOKEN=
